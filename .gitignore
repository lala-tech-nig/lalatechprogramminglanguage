# ============================================================
# GLOBAL PROJECT IGNORE RULES
# ============================================================

# ------------------------------------------------------------
# DEPENDENCIES — ANY FOLDER
# ------------------------------------------------------------
node_modules/
**/node_modules/

.pnp
.pnp.*
**/.pnp
**/.pnp.*

.yarn/
**/.yarn/

# Keep Yarn files that are normally safe to commit
!.yarn/patches/
!.yarn/plugins/
!.yarn/releases/
!.yarn/versions/


# ------------------------------------------------------------
# ENVIRONMENT / SECRETS — ANY FOLDER
# ------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*

# Allow example environment files if you want to commit templates
!.env.example
!**/.env.example

# Common secret/key files
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
**/*.pem
**/*.key
**/*.crt
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore


# ------------------------------------------------------------
# NEXT.JS — ANY FOLDER
# ------------------------------------------------------------
.next/
**/.next/

out/
**/out/

next-env.d.ts
**/next-env.d.ts

*.tsbuildinfo
**/*.tsbuildinfo


# ------------------------------------------------------------
# REACT / VITE / WEB BUILD OUTPUT — ANY FOLDER
# ------------------------------------------------------------
# dist/
# **/dist/
# dist/
# **/dist/

build/
**/build/

.vite/
**/.vite/


# ------------------------------------------------------------
# VERCEL — ANY FOLDER
# ------------------------------------------------------------
.vercel/
**/.vercel/


# ------------------------------------------------------------
# TESTING / COVERAGE — ANY FOLDER
# ------------------------------------------------------------
coverage/
**/coverage/

.nyc_output/
**/.nyc_output/

playwright-report/
**/playwright-report/

test-results/
**/test-results/


# ------------------------------------------------------------
# LOGS / DEBUG FILES — ANY FOLDER
# ------------------------------------------------------------
*.log
**/*.log

npm-debug.log*
**/npm-debug.log*

yarn-debug.log*
**/yarn-debug.log*

yarn-error.log*
**/yarn-error.log*

pnpm-debug.log*
**/pnpm-debug.log*

lerna-debug.log*
**/lerna-debug.log*


# ------------------------------------------------------------
# OS FILES — ANY FOLDER
# ------------------------------------------------------------
.DS_Store
**/.DS_Store

Thumbs.db
**/Thumbs.db

Desktop.ini
**/Desktop.ini

*.swp
*.swo
*~


# ------------------------------------------------------------
# IDE / EDITOR — ANY FOLDER
# ------------------------------------------------------------
.vscode/
**/.vscode/

.idea/
**/.idea/

*.iml
**/*.iml

*.suo
*.user
*.userosscache
*.sln.docstates


# ------------------------------------------------------------
# TEMPORARY FILES — ANY FOLDER
# ------------------------------------------------------------
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

tmp/
**/tmp/

temp/
**/temp/


# ------------------------------------------------------------
# DATABASE / LOCAL DEVELOPMENT FILES
# ------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
**/*.sqlite
**/*.sqlite3
**/*.db


# ------------------------------------------------------------
# CACHE — ANY FOLDER
# ------------------------------------------------------------
.cache/
**/.cache/

.parcel-cache/
**/.parcel-cache/

.eslintcache
**/.eslintcache/

.stylelintcache
**/.stylelintcache/


# ------------------------------------------------------------
# COMMON FRAMEWORK GENERATED FILES
